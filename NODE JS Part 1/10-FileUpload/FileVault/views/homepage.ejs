<!DOCTYPE html>
<html>

<head>

    <title>FileVault</title>

</head>

<body>

    <h1>FileVault</h1>

    <h2>Upload File</h2>


    <form action="/files" method="POST" enctype="multipart/form-data">

        <input type="file" name="file" required />

        <button type="submit">
            Upload
        </button>

    </form>


    <hr>


    <h2>Uploaded Files</h2>


    <% if (files.length===0) { %>

        <p>No files uploaded yet.</p>

        <% } %>


            <% files.forEach(file=> { %>

                <div>

                    <p>
                        <strong>
                            <%= file.originalName %>
                        </strong>
                    </p>

                    <p>
                        Type:
                        <%= file.mimeType %>
                    </p>

                    <p>
                        Size:
                        <%= (file.size / 1024).toFixed(2) %> KB
                    </p>

                    <a href="<%= file.url %>" target="_blank">
                        Open File
                    </a>

                    <button onclick="deleteFile('<%= file._id %>')">
                        Delete
                    </button>

                </div>

                <hr>

                <% }) %>


                    <script>

                        async function deleteFile(id) {

                            const response = await fetch(
                                `/files/${id}`,
                                {
                                    method: "DELETE"
                                }
                            );


                            const data = await response.json();

                            alert(data.message);


                            if (response.ok) {

                                location.reload();

                            }

                        }

                    </script>

</body>

</html>